# ============================================================
#  .env.example — Copy this file to .env and fill in your values
# ============================================================

# ── IBM watsonx.ai credentials ──────────────────────────────
# Obtain from: https://cloud.ibm.com/iam/apikeys
IBM_WATSONX_API_KEY=
# watsonx.ai Dallas endpoint (us-south) — fastest for Lite tier
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Obtain from: https://dataplatform.cloud.ibm.com → Project → Manage → General
IBM_WATSONX_PROJECT_ID=
IBM_GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

IBM_TRANSLATOR_API_KEY=
IBM_TRANSLATOR_URL=

# ── Application ──────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
SECRET_KEY=changeme
LOG_LEVEL=INFO

# ── RAG / Vector Store ───────────────────────────────────────
VECTORSTORE_DIR=./data/vectorstore
DOCUMENTS_DIR=./data/documents
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RESULTS=5

# ── LLM Generation parameters ───────────────────────────────
# granite-4-h-small supports generation output up to 8192 tokens.
# 1024 gives full, detailed answers well within Lite tier quotas.
LLM_MAX_NEW_TOKENS=1024
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_REPETITION_PENALTY=1.1

# ── Embeddings ───────────────────────────────────────────────
# ibm/granite-embedding-278m-multilingual: confirmed available on Lite tier,
# supports all 11 Indian languages used by this agent. Replaces the
# deprecated ibm/slate-125m-english-rtrvr (removed from watsonx.ai).
IBM_WATSONX_EMBEDDING_MODEL_ID=ibm/granite-embedding-278m-multilingual

# ── Language support ─────────────────────────────────────────
SUPPORTED_LANGUAGES=en,hi,ta,te,bn,mr,gu,kn,ml,pa,ur

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=*
